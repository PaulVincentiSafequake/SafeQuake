{
  "expo": {
    "name": "Quake Angel",
    "slug": "frontend",
    "version": "1.0.35",
    "orientation": "portrait",
    "icon": "./assets/icons/quake_angel_ios_v3.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paulvincenti.quakeguard",
      "buildNumber": "35",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.usernotifications.critical-alerts": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Quake Angel",
        "UIBackgroundModes": ["remote-notification"],
        "NSLocationWhenInUseUsageDescription": "Share your location to report you are safe",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Share your location to report you are safe"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/quake_angel_android_fg_v3.png",
        "backgroundImage": "./assets/icons/quake_angel_android_bg_v3.png",
        "backgroundColor": "#F5B70E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.paulvincenti.quakeguard",
      "versionCode": 35,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Share your location to report you are safe"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production",
          "sounds": ["./assets/audio/siren.caf", "./assets/audio/recheck.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
