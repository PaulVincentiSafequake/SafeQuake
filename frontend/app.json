{
  "expo": {
    "name": "QuakeGuard",
    "slug": "frontend",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paulvincenti.quakeguard",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.usernotifications.critical-alerts": true
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your location to report you are safe",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Share your location to report you are safe"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.paulvincenti.quakeguard",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Share your location to report you are safe"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production",
          "sounds": ["./assets/audio/siren.caf"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
