<!--
  ═══════════════════════════════════════════════════════════════════════════
  QuakeGuard — HTML for the "Trigger Earthquake Alert" button
  Goes into your dashboard's index.html
  ═══════════════════════════════════════════════════════════════════════════

  Two blocks below:
    BLOCK A → paste inside the <head>...</head> (just before </head>)
    BLOCK B → paste inside <body> wherever you want the button to appear
              (e.g. in your dashboard toolbar / header, next to any other
               action buttons you have)

  Do NOT put both blocks in the same place. BLOCK A must be in <head>,
  BLOCK B must be in <body>.
-->


<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- BLOCK A — paste inside <head>...</head>, just before the closing </head> -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<style>
  #qg-trigger-wrap {
    display: inline-block;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  #qg-trigger-btn {
    background: #FF3B30;
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: none;
    border-radius: 12px;
    padding: 14px 22px;
    cursor: pointer;
    box-shadow: 0 6px 22px rgba(255, 59, 48, 0.35);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: transform .08s ease, opacity .15s ease;
  }
  #qg-trigger-btn:hover  { transform: translateY(-1px); }
  #qg-trigger-btn:active { transform: translateY(0); opacity: .9; }
  #qg-trigger-btn[disabled] { opacity: .55; cursor: not-allowed; }
  #qg-trigger-status {
    display: block;
    margin-top: 10px;
    font-size: 13px;
    min-height: 18px;
  }
  #qg-trigger-status.ok   { color: #1F8A3A; }
  #qg-trigger-status.err  { color: #C21818; }
  #qg-trigger-status.info { color: #666;    }
</style>


<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- BLOCK B — paste inside <body>, wherever you want the button to render  -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div id="qg-trigger-wrap">
  <button id="qg-trigger-btn" type="button" aria-label="Trigger earthquake alert">
    <span aria-hidden="true">⚠️</span>
    Trigger Earthquake Alert
  </button>
  <span id="qg-trigger-status" role="status" aria-live="polite"></span>
</div>
